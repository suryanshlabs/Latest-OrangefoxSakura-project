# twrp.flags — mount list for sakura (OrangeFox R12.0)
#
# Union of the R11.0_5 recovery.fstab mount points (so nothing is lost vs the
# official build) and the modern system-as-root layout used by Android 10+ ROMs.
#
# mount point    fstype  device                                  device2        flags
/boot            emmc    /dev/block/bootdevice/by-name/boot
/cache           ext4    /dev/block/bootdevice/by-name/cache
/recovery        emmc    /dev/block/bootdevice/by-name/recovery                    flags=backup=1;display="Recovery"

# Modern ROMs mount /system as system-as-root; legacy ROMs as /system.
/system_root     ext4    /dev/block/bootdevice/by-name/system      flags=display="System";wipeingui
/system          ext4    /dev/block/bootdevice/by-name/system      flags=display="System (legacy)";backup=0
/vendor          ext4    /dev/block/bootdevice/by-name/vendor      flags=display="Vendor";wipeingui

/system_image    emmc    /dev/block/bootdevice/by-name/system
/vendor_image    emmc    /dev/block/bootdevice/by-name/vendor

# Encryption + firmware. mounttodecrypt is required for the FDE key fetch.
/data            auto    /dev/block/bootdevice/by-name/userdata    flags=display="Data";backup=1;wipeingui;wipedngui;mounttodecrypt
/firmware        vfat    /dev/block/bootdevice/by-name/modem       flags=display="Firmware";mounttodecrypt
/modem           emmc    /dev/block/bootdevice/by-name/modem       flags=backup=1;display="Modem"
/dsp             emmc    /dev/block/bootdevice/by-name/dsp         flags=backup=1;subpartitionof=/modem

# Identifiers — never wipe these.
/persist         ext4    /dev/block/bootdevice/by-name/persist     flags=display="Persist";backup=1
/persist_image   emmc    /dev/block/bootdevice/by-name/persist     flags=display="Persist";backup=1;flashimg=1
/cust            ext4    /dev/block/bootdevice/by-name/cust        flags=display="Cust";backup=1;wipeingui
/misc            emmc    /dev/block/bootdevice/by-name/misc

# Baseband / EFS group (identical grouping to R11.0_5)
/efs1            emmc    /dev/block/bootdevice/by-name/modemst1    flags=backup=1;display="EFS"
/efs2            emmc    /dev/block/bootdevice/by-name/modemst2    flags=backup=1;subpartitionof=/efs1
/efsc            emmc    /dev/block/bootdevice/by-name/fsc         flags=backup=1;subpartitionof=/efs1
/efsg            emmc    /dev/block/bootdevice/by-name/fsg         flags=backup=1;subpartitionof=/efs1

# Removable storage
/external_sd     auto    /dev/block/mmcblk1p1                      flags=display="MicroSD";storage;wipeingui;removable
/usb_otg         auto    /dev/block/sda1          /dev/block/sda flags=display="USB OTG";storage;wipeingui;removable
