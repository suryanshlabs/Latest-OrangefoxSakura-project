# Android fstab for sakura — OrangeFox R12.0
#
# Parsed by vold/decrypt work. R11.0_5 used a legacy 4-column TWRP fstab with
# an ext4-only /data and encryptable=footer (FDE). This R12 version keeps FDE
# support for Android 9 ROMs and declares FBE via fileencryption=ice, plus an
# f2fs /data row so f2fs-formatted data can be mounted.
#
# fileencryption=ice is not "inline crypto": the pinned recovery passes it to
# fbe.contents, and android-12.1 libfscrypt maps it to FSCRYPT_MODE_PRIVATE (the
# pre-Android-11 vendor contents format). Inline crypto would be the separate
# 'inlinecrypt' mount option. See documentation/ENCRYPTION.md sect. 3.
#
# NOT declared on purpose: metadata_encryption= / keydirectory=.
# sakura's vendor is Keymaster 3.0 and neither available kernel has
# dm-default-key, so metadata-encrypted /data cannot be handled. Declaring it
# would produce a recovery that silently fails. See documentation/ENCRYPTION.md.
#
#<src>                                        <mnt_point> <type> <mnt_flags and options>                 <fs_mgr_flags>

/dev/block/bootdevice/by-name/system           /system     ext4   ro,barrier=1,discard                      wait
/dev/block/bootdevice/by-name/vendor           /vendor     ext4   ro,barrier=1,discard                      wait
/dev/block/bootdevice/by-name/cache            /cache      ext4   nosuid,nodev,noatime,barrier=1            wait,check
/dev/block/bootdevice/by-name/persist          /persist    ext4   nosuid,nodev,noatime,barrier=1            wait
/dev/block/bootdevice/by-name/cust             /cust       ext4   ro,barrier=1                              wait

# /data — f2fs first (modern ROMs), ext4 second (stock / older ROMs).
# encryptable=footer keeps the legacy FDE key location (Android 9);
# fileencryption=ice marks the row as FBE and selects the vendor 'ice' contents
# mode. Both are only attempted when the TEE blobs are present; quota and
# formattable are required by R12 tooling. See documentation/ENCRYPTION.md.
#
# SEPARATORS: AOSP fs_mgr tokenises the fs_mgr flags column on COMMAS, and
# commas only. Never use ';' here: "encryptable=footer;fileencryption=ice" is
# parsed as ONE malformed token, so both the FDE footer and the FBE policy are
# silently dropped. tools/static_checks.py enforces this as a regression gate.
/dev/block/bootdevice/by-name/userdata         /data       f2fs   nosuid,nodev,noatime,inline_xattr,data_flush  wait,check,encryptable=footer,fileencryption=ice,quota,formattable
/dev/block/bootdevice/by-name/userdata         /data       ext4   nosuid,nodev,noatime,noauto_da_alloc          wait,check,encryptable=footer,fileencryption=ice,quota,formattable

# Needed by update_engine-style code to resolve the boot device even though the
# mount point itself is unused.
/dev/block/bootdevice/by-name/misc             /misc       emmc   defaults                                      defaults
