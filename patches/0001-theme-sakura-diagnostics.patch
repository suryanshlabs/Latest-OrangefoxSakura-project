diff --git a/gui/theme/portrait_hdpi/pages/templates/statusbar.xml b/gui/theme/portrait_hdpi/pages/templates/statusbar.xml
index 4cb1f75..3c461c3 100644
--- a/gui/theme/portrait_hdpi/pages/templates/statusbar.xml
+++ b/gui/theme/portrait_hdpi/pages/templates/statusbar.xml
@@ -2,6 +2,27 @@
 <recovery>
 	<templates>
 		<template name="statusbarinfo">
+			<!--
+				sakura: boot diagnostic badge. Hidden unless the early-boot
+				collector counted a real, actionable error (of.boot_diag_errors is
+				set to 0 by init.recovery.sakura_diag.rc before the GUI exists, so an
+				unset property can never light it). Required-service absence within
+				the grace period, optional HALs and unclassified logcat errors are
+				deliberately not counted, so this is not a "something logged an E"
+				badge. Tapping it opens Settings -> Error Logs. The condition is
+				evaluated when the page renders: it is not a live indicator.
+			-->
+			<text style="text_status">
+				<condition var1="property.of.boot_diag_errors" op="!=" var2="0"/>
+				<placement x="756" y="%status_info_y%"/>
+				<text>! DIAG</text>
