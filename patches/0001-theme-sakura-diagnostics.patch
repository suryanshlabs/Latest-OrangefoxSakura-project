+++ b/gui/theme/portrait_hdpi/pages/diag.xml
@@ -0,0 +1,392 @@
+<?xml version="1.0"?>
+<recovery>
+	<pages>
+		<!--
+			sakura: Error Logs / boot diagnostics.
+
+			Pure theme XML on purpose. Every action used here already exists in
+			the pinned bootable/recovery at 8d2aad19:
+			  * `cmd`    runs a shell command in a worker thread (gui/action.cpp
+			             "These actions will run in a separate thread"),
+			  * `set`    sets a GUI variable,
+			  * `page`   switches pages,
+			  * `reload` re-renders the current page,
+			  * `property.<name>` is resolved by DataManager::GetValue()
+			             (data.cpp:442/523), so `%property.of.…%` and
+			             `<condition var1="property.of.…">` read what
+			             `/system/bin/sakura-diag` sets with setprop,
+			  * `fileexists` conditions stat a path, and
+			  * a listbox with `<data name="of_file_to_read"/>` renders a file
+			             (gui/listbox.cpp:340 ReadFileToList; 1.5 MiB limit,
+			             and sakura-diag caps every log at 256 KiB).
+			No C++ modification is required, so this is shipped as a theme patch
+			(patches/0001-theme-sakura-diagnostics.patch) rather than a fork.
+
+			Log files (all redacted at collection time):
+			  recovery-log.txt   sanitized copy of /tmp/recovery.log (the
+			                     original is never modified or shown here)
+			  boot-diag.txt      timestamped collector trail
+			  errors.txt         critical only
+			  warnings.txt       recoverable (avc, mmc timeout, benign tags)
+			  triage.txt         unclassified logcat E/F lines (not counted)
+			  crypto-errors.txt  TEE / crypto / mount filters
+			  dmesg.txt logcat.txt services.txt mounts.txt encryption.txt
+			  report.txt         newest redacted report
+		-->
+		<page name="error_logs">
+			<listbox style="group_list">
+				<placement x="0" y="%ab_h%" w="%screen_w%" h="%bl_fullscreen_h%"/>
+				<iconsize w="216" h="168" padding="24"/>
+
+				<listitem name="{@diag_view_recovery}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/recovery-log.txt</action>
+					<action function="set">tw_diag_log={@diag_view_recovery}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_boot}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/boot-diag.txt</action>
+					<action function="set">tw_diag_log={@diag_view_boot}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_errors}">
+					<icon res="icon_warning"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/errors.txt</action>
+					<action function="set">tw_diag_log={@diag_view_errors}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_warnings}">
+					<icon res="icon_warning"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/warnings.txt</action>
+					<action function="set">tw_diag_log={@diag_view_warnings}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_triage}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/triage.txt</action>
+					<action function="set">tw_diag_log={@diag_view_triage}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_crypto}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/crypto-errors.txt</action>
+					<action function="set">tw_diag_log={@diag_view_crypto}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_dmesg}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/dmesg.txt</action>
+					<action function="set">tw_diag_log={@diag_view_dmesg}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_logcat}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/logcat.txt</action>
+					<action function="set">tw_diag_log={@diag_view_logcat}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_services}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/services.txt</action>
+					<action function="set">tw_diag_log={@diag_view_services}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_mounts}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/mounts.txt</action>
+					<action function="set">tw_diag_log={@diag_view_mounts}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_view_encryption}">
+					<icon res="bs_btn_set_about"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/encryption.txt</action>
+					<action function="set">tw_diag_log={@diag_view_encryption}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+
+				<!-- The report only appears once it exists, so a tap can never
+				     open an empty viewer. -->
+				<listitem name="{@diag_view_report}">
+					<icon res="bs_btn_set_about"/>
+					<condition var1="fileexists" var2="/tmp/sakura-diag/report.txt"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/report.txt</action>
+					<action function="set">tw_diag_log={@diag_view_report}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_generate_report}">
+					<icon res="bs_btn_set_custom"/>
+					<action function="cmd">/system/bin/sakura-diag report</action>
+					<action function="page">error_logs_report</action>
+				</listitem>
+				<listitem name="{@diag_copy_hdr}">
+					<icon res="bs_btn_restore"/>
+					<action function="page">error_logs_copy</action>
+				</listitem>
+				<listitem name="{@diag_export}">
+					<icon res="bs_btn_restore"/>
+					<action function="cmd">/system/bin/sakura-diag export</action>
+					<action function="page">error_logs_exported</action>
+				</listitem>
+				<listitem name="{@diag_clear}">
+					<icon res="icon_warning"/>
+					<action function="page">error_logs_clear</action>
+				</listitem>
+			</listbox>
+
+			<template name="base"/>
+
+			<text style="text_ab_title">
+				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
+				<text>{@diag_hdr}</text>
+			</text>
+
+			<text style="caption">
+				<placement x="%col1_x_indent%" y="%row1_2_y%" w="%console_width%"/>
+				<text>{@diag_note}</text>
+			</text>
+
+			<template name="gestures"/>
+
+			<action>
+				<touch key="home"/>
+				<action function="page">main</action>
+			</action>
+			<action>
+				<touch key="back"/>
+				<action function="page">settings</action>
+			</action>
+		</page>
+
+		<!--
+			Log viewer. Same listbox/textbox + of_file_to_read mechanism as the
+			stock cat_file page, but back returns to Error Logs instead of the
+			file manager, and the variable is cleared so the file is released.
+		-->
+		<page name="diag_view">
+			<action>
+				<action function="set">of_file_to_read=%tw_filename1%</action>
+			</action>
+
+			<listbox style="textbox">
+				<font resource="fixed" spacing="1" color="%text%"/>
+				<placement x="%col1_x%" y="%ab_ex_h%" w="%console_width%" h="%fileselector_terminal_height%"/>
+				<data name="of_file_to_read"/>
+			</listbox>
+
+			<template name="base_ex"/>
+
+			<animation>
+				<condition var1="tw_busy" var2="1"/>
+				<placement x="%progressbar_x%" y="%progressbar_y%"/>
+				<resource name="progress"/>
+				<speed fps="30" render="2"/>
+				<loop frame="1"/>
+			</animation>
+
+			<text style="text_ab_title">
+				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
+				<text>%tw_diag_log%</text>
+			</text>
+
+			<text style="text_ab_subtitle_lim">
+				<placement x="%col1_x%" y="%row1_2_y%"/>
+				<text>%tw_filename1%</text>
+			</text>
+
+			<template name="gestures"/>
+
+			<action>
+				<touch key="back"/>
+				<action function="set">of_file_to_read=</action>
+				<action function="page">error_logs</action>
+			</action>
+			<action>
+				<touch key="home"/>
+				<action function="set">of_file_to_read=</action>
+				<action function="page">main</action>
+			</action>
+		</page>
+
+		<page name="error_logs_report">
+			<template name="base"/>
+			<text style="text_ab_title">
+				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
+				<text>{@diag_report_hdr}</text>
+			</text>
+			<text style="text_body1">
+				<placement x="%col1_x_indent%" y="%row1_2_y%" w="%console_width%"/>
+				<text>{@diag_report_body}</text>
+			</text>
+			<listbox style="group_list">
+				<placement x="0" y="%row3_1_y%" w="%screen_w%" h="%bl_files_h%"/>
+				<iconsize w="216" h="168" padding="24"/>
+				<listitem name="{@diag_view_report}">
+					<icon res="bs_btn_set_about"/>
+					<condition var1="fileexists" var2="/tmp/sakura-diag/report.txt"/>
+					<action function="set">tw_filename1=/tmp/sakura-diag/report.txt</action>
+					<action function="set">tw_diag_log={@diag_view_report}</action>
+					<action function="page">diag_view</action>
+				</listitem>
+				<listitem name="{@diag_back}">
+					<icon res="bs_btn_set_about"/>
+					<action function="page">error_logs</action>
+				</listitem>
+			</listbox>
+			<template name="gestures"/>
+			<action>
+				<touch key="back"/>
+				<action function="page">error_logs</action>
+			</action>
+			<action>
+				<touch key="home"/>
+				<action function="page">main</action>
+			</action>
+		</page>
+
+		<page name="error_logs_exported">
+			<template name="base"/>
+			<text style="text_ab_title">
+				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
+				<text>{@diag_export_hdr}</text>
+			</text>
+			<text style="text_body1">
+				<placement x="%col1_x_indent%" y="%row1_2_y%" w="%console_width%"/>
+				<text>{@diag_export_body}</text>
+			</text>
+			<template name="gestures"/>
+			<action>
+				<touch key="back"/>
+				<action function="page">error_logs</action>
+			</action>
+			<action>
+				<touch key="home"/>
+				<action function="page">main</action>
+			</action>
+		</page>
+
+		<!--
+			Copy one redacted log to writable storage. `cmd` runs in a worker
+			thread, so the status line shows the result of the copy that was
+			requested last (of.boot_diag_last_copy, set by sakura-diag).
+		-->
