diff --git a/gui/theme/portrait_hdpi/pages/templates/statusbar.xml b/gui/theme/portrait_hdpi/pages/templates/statusbar.xml
index 4cb1f75..349b4c2 100644
--- a/gui/theme/portrait_hdpi/pages/templates/statusbar.xml
+++ b/gui/theme/portrait_hdpi/pages/templates/statusbar.xml
@@ -2,6 +2,25 @@
 <recovery>
 	<templates>
 		<template name="statusbarinfo">
+			<!--
+				sakura: boot diagnostic badge. Hidden unless the early-boot
+				collector counted a real error (property.of_* is resolved through
+				DataManager::GetValue, which supports the `property.` prefix).
+				Tapping it opens Settings -> Error Logs. Optional HALs are excluded
+				from the count by sakura-diag, so their absence never lights it.
+			-->
+			<text style="text_status">
+				<condition var1="property.of.boot_diag_errors" op="!=" var2="0"/>
+				<condition var1="property.of.boot_diag_errors" op="!=" var2=""/>
+				<placement x="756" y="%status_info_y%"/>
+				<text>! DIAG</text>
+			</text>
+			<action>
+				<condition var1="property.of.boot_diag_errors" op="!=" var2="0"/>
+				<touch x="746" y="8" w="170" h="64"/>
+				<action function="page">error_logs</action>
+			</action>
+
 			<!-- Time, etc. -->
 			<text style="text_status">
 				<condition var1="show_cpu_temp" var2="0"/>
