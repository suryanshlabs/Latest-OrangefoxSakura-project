+				<placement x="0" y="%ab_h%" w="%screen_w%" h="%bl_fullscreen_h%"/>
+				<iconsize w="216" h="168" padding="24"/>
+				<listitem name="{@diag_copy_recovery}">
+					<icon res="bs_btn_restore"/>
+					<action function="cmd">/system/bin/sakura-diag copy recovery</action>
+					<action function="reload"/>
+				</listitem>
+				<listitem name="{@diag_copy_boot}">
+					<icon res="bs_btn_restore"/>
+					<action function="cmd">/system/bin/sakura-diag copy boot</action>
+					<action function="reload"/>
+				</listitem>
+				<listitem name="{@diag_copy_errors}">
+					<icon res="bs_btn_restore"/>
+					<action function="cmd">/system/bin/sakura-diag copy errors</action>
+					<action function="reload"/>
+				</listitem>
+				<listitem name="{@diag_copy_warnings}">
