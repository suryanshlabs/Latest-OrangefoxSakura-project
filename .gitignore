# Downloaded reference artifacts, unpacked binaries and build output.
# The 46.5 MB R11.0_5 release ZIP must never be committed: download it with
# build/fetch_reference.sh instead (checksum-verified in documentation/).
reference/
*.zip
*.img
*.gz-dtb
!documentation/**/*.txt

# Python
__pycache__/
*.pyc

# Local build trees / logs
out/
*.log
.env

# Handoff bundle / inspection inputs (proprietary image + audit packaging).
handoff/

# ---------------------------------------------------------------------------
# Proprietary vendor blobs (QTI TEE chain: qseecomd, QTI Keymaster 3.0, QTI
# Gatekeeper 1.0 + libraries). Xiaomi/Qualcomm code: never committed, never
# redistributed. They are extracted locally from the user's own sakura stock
# fastboot ROM by build/extract_blobs.sh and installed by build/install_blobs.sh.
# The manifest and the tooling ARE tracked; only the binaries are ignored.
# ---------------------------------------------------------------------------
vendor_blobs/
device/xiaomi/sakura/blob_install.mk
# Only the blob directories inside recovery/root are ignored - the tracked
# recovery.fstab, twrp.flags and init fragments live in system/etc and the
# ramdisk root and must stay versioned.
device/xiaomi/sakura/recovery/root/system/bin/
device/xiaomi/sakura/recovery/root/system/lib64/
